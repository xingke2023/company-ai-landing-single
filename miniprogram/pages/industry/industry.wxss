.root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F8F2ED;
}

/* Header */
.header {
  background: linear-gradient(135deg, #E65C46 0%, #c9402a 100%);
  flex-shrink: 0;
}
.header-inner {
  padding: 28rpx 40rpx 40rpx;
}
.brand {
  color: #fff;
  font-weight: 400;
  font-size: 52rpx;
  line-height: 1.2;
}
.brand-sub {
  color: rgba(255,255,255,0.85);
  font-size: 30rpx;
  margin-top: 12rpx;
}

/* Body */
.body {
  flex: 1;
  min-height: 0;
}
.loading {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 32rpx 28rpx 8rpx;
}
.card {
  width: 47%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 18rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  text-align: center;
}
.card-hover {
  background: #fdf3f0;
  transform: scale(0.98);
}
.card-icon {
  width: 50rpx;
  height: 50rpx;
}
.card-emoji {
  font-size: 48rpx;
  line-height: 50rpx;
}
.card-name {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.card-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.35;
}

.footer-tip {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  padding: 16rpx 40rpx 48rpx;
}
