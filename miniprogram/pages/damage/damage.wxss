.root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F8F2ED;
}

/* Header */
.header {
  background: linear-gradient(135deg, #E65C46 0%, #c9402a 100%);
  flex-shrink: 0;
}
.header-inner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 24rpx;
}
.back-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
}
.header-title {
  flex: 1;
  text-align: center;
  color: #fff;
  font-weight: 700;
  font-size: 32rpx;
}
.header-spacer { width: 56rpx; }

/* Body */
.body { flex: 1; padding: 24rpx; box-sizing: border-box; }
.tip {
  font-size: 24rpx;
  color: #8a7a70;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 今日已记录 */
.today-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(42,31,25,0.05);
}
.today-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.today-title { font-size: 28rpx; font-weight: 700; color: #2A1F19; }
.today-count { font-size: 24rpx; color: #E65C46; font-weight: 600; }
.today-empty { font-size: 24rpx; color: #a99c92; padding: 16rpx 0 6rpx; }
.trec {
  padding: 18rpx 0;
  border-top: 2rpx solid #f1e8e1;
}
.trec-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.trec-title { font-size: 27rpx; color: #2A1F19; font-weight: 600; flex: 1; min-width: 0; }
.trec-time { font-size: 22rpx; color: #a99c92; flex-shrink: 0; padding-left: 12rpx; }
.trec-sub {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  font-size: 22rpx;
  color: #8a7a70;
}
.trec-reason {
  background: rgba(230,92,70,0.08);
  color: #E65C46;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.trec-status { color: #6a5b52; }
.trec-notes { color: #a99c92; }
.trec-photos { display: flex; gap: 12rpx; margin-top: 12rpx; }
.trec-thumb { width: 110rpx; height: 110rpx; border-radius: 10rpx; }

/* 分段标题 */
.section-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #2A1F19;
  margin: 4rpx 4rpx 12rpx;
}

/* Card */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 32rpx;
  box-shadow: 0 4rpx 18rpx rgba(42,31,25,0.05);
}
.field { margin-bottom: 26rpx; }
.field-label {
  display: block;
  font-size: 26rpx;
  color: #2A1F19;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.req { color: #E65C46; }
.field-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  background: #F8F2ED;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  color: #2A1F19;
}
.custom-reason { margin-top: 16rpx; }
.ph { color: #b5a89f; font-size: 28rpx; }

/* Reason chips —— 尽量一行 */
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #F8F2ED;
  border: 2rpx solid transparent;
  font-size: 24rpx;
  color: #6a5b52;
}
.chip-on {
  background: rgba(230,92,70,0.08);
  border-color: #E65C46;
  color: #E65C46;
  font-weight: 600;
}

/* Photos */
.photo-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.photo-item { position: relative; width: 150rpx; height: 150rpx; }
.photo-thumb { width: 150rpx; height: 150rpx; border-radius: 14rpx; }
.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 30rpx;
}
.photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  border: 2rpx dashed #d8c8bd;
  background: #F8F2ED;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.photo-add-plus { font-size: 44rpx; color: #b5a89f; line-height: 1; }
.photo-add-text { font-size: 22rpx; color: #b5a89f; margin-top: 6rpx; }

/* Add to list button */
.btn-add {
  margin-top: 8rpx;
  background: rgba(230,92,70,0.08);
  color: #E65C46;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 20rpx 0;
  line-height: 1.4;
}
.btn-add::after { border: none; }

/* Draft list */
.list-head {
  margin: 30rpx 4rpx 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A1F19;
}
.draft {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(42,31,25,0.04);
}
.draft-main { flex: 1; min-width: 0; }
.draft-title { font-size: 28rpx; color: #2A1F19; font-weight: 600; }
.draft-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a7a70;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
}
.draft-reason {
  background: rgba(230,92,70,0.08);
  color: #E65C46;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.draft-photos { color: #6a5b52; }
.draft-notes { color: #8a7a70; }
.draft-acts { display: flex; gap: 22rpx; flex-shrink: 0; padding-left: 18rpx; }
.draft-edit { font-size: 26rpx; color: #6a5b52; }
.draft-remove { font-size: 26rpx; color: #E65C46; }

/* Confirm stage */
.confirm-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(42,31,25,0.04);
}
.confirm-idx {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #E65C46;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 18rpx;
}
.confirm-body { flex: 1; min-width: 0; }
.confirm-title { font-size: 28rpx; font-weight: 700; color: #2A1F19; margin-bottom: 8rpx; }
.confirm-row { font-size: 24rpx; color: #6a5b52; line-height: 1.7; }
.confirm-time { color: #a99c92; }
.confirm-photos { display: flex; gap: 12rpx; margin-top: 12rpx; }
.confirm-thumb { width: 110rpx; height: 110rpx; border-radius: 10rpx; }

.bottom-pad { height: 40rpx; }

/* Footer */
.footer {
  flex-shrink: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 18rpx rgba(42,31,25,0.05);
}
.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #FF7A5C, #E65C46);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}
.btn-primary[disabled] { opacity: 0.6; }
.btn-primary::after { border: none; }
.btn-flex { flex: 2; }
.btn-ghost {
  flex: 1;
  background: #F8F2ED;
  color: #6a5b52;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}
.btn-ghost::after { border: none; }
